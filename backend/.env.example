# Copy to .env and fill in real values (never commit .env)
# Local development can keep the frontend default API URL on port 3001.
# Northflank provides PORT at runtime; leave it unset there unless overriding.
PORT=3001

# Recommended for Neon/hosted Postgres. Keep the full URL secret.
# The app converts this to JDBC and extracts the username/password automatically.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Local/manual JDBC config. Use this instead of DATABASE_URL for local Postgres.
DB_URL=jdbc:postgresql://localhost:5432/newsexplorer
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_256_bit_random_secret
JWT_EXPIRATION_MS=86400000

# Optional seeded recruiter demo account
DEMO_EMAIL=demo@newsexplorer.dev
DEMO_PASSWORD=DemoReader!2026
DEMO_NAME=Demo Reader

# Origin of the React dev server (no trailing slash)
ALLOWED_ORIGIN=http://localhost:3000
