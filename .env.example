# Copy to .env.local for local development (never commit .env or .env.local)

# Spring Boot API base URL (no trailing slash)
VITE_API_URL=http://localhost:3001

# NewsAPI key for article search (https://newsapi.org/)
VITE_NEWS_API_KEY=your_newsapi_key_here

# Set to "true" to use mock search results instead of the News API
VITE_USE_MOCK=false
